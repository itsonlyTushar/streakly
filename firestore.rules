rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Allow users to remove data from retired modules from Settings.
    match /goals/{goalId} {
      allow read, delete: if isOwner(resource.data.userId);
    }

    match /tasks/{taskId} {
      allow read, delete: if isOwner(resource.data.userId);
    }

    match /taskProjects/{projectId} {
      allow read, delete: if isOwner(resource.data.userId);
    }

    match /flashcards/{cardId} {
      allow read, delete: if isOwner(resource.data.userId);
    }

    // Notes collection rules
    match /notes/{noteId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Notebooks collection rules
    match /notebooks/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Spaced Repetition System (SRS) collection rules
    match /srs/{srsId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // DSA collection rules
    match /dsa/{dsaId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Machine Coding collection rules
    match /machineCoding/{entryId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Profiles collection rules
    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
